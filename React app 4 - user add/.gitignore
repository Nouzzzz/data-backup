const Card = ({ user, onDelete }) => {

  const editc = () => {
   
  };  

  const deletec = () => {
    
    onDelete(user.id);
  };

  return (
    <div className="card">
      <h2>{user.name}</h2>
      <p>Email: {user.email}</p>
      <p>Age: {user.age}</p>
      
      <div className="btns">
        <button className="editbtn" onClick={editc}>Edit</button>
        <button className="deletebtn" onClick={deletec}>Delete</button>
      </div>
    </div>
  );
};

export default Card;
